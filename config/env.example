# ============================================================
# env.example — Plantilla del archivo .env de la aplicación
#
# Copie este archivo a .env (en la raíz del proyecto) y complete
# los valores reales:
#
#     cp config/env.example .env
#
# El archivo .env está excluido de Git (.gitignore) para que las
# contraseñas NUNCA se suban al repositorio.
# ============================================================

# Conexión a MariaDB
DB_HOST=localhost
DB_NAME=productos_db
DB_USER=appuser
DB_PASS=cambiar_esta_clave

# Usuario de solo lectura para los respaldos (mysqldump)
BCK_USER=bckuser
BCK_PASS=cambiar_esta_clave
